# Variáveis de conexão com o banco de dados (Mude com suas credenciais)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=altave
MYSQL_PASSWORD=123456
MYSQL_DATABASE=test

# Define senha de Admin para o banco
MYSQL_ROOT_PASSWORD=123456

# Define se o ambiente é de produção ou desenvolvimento
production=false

# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Mude a connection string de acordo com as credenciais que você já mudou
DATABASE_URL="mysql://root:123456@localhost:3307/test"

# Segredo usado para assinar/verificar o cookie de sessão (lib/auth/sessao.ts).
# Obrigatório: sem ele a verificação de sessão lança erro.
# Gere um valor próprio, ex: openssl rand -base64 32
SESSION_SECRET="troque-este-valor"

# --- Opcional: banco bdr_api (3ª avaliação de BDR, Parte 5) ---------------
# Veja docs/dev/banco-bdr.md. Com USAR_ROTINAS_BDR=true a criação de ticket usa
# a procedure sp_abrir_ticket e as consultas trazem situacaoSla (fn_situacao_sla).
# Só ligue apontando para o bdr_api (o banco de dev não tem essas rotinas).
# USAR_ROTINAS_BDR=true
# MYSQL_SESSION_TIME_ZONE=+00:00
